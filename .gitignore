# Cargo build output. live-tests/ and the tools are standalone workspaces with
# their own committed Cargo.lock; only the build directories are ignored.
target/
# Regtest chain cache built by the live suite (live-tests/zaino-testutils/src/cache.rs).
/live-tests/.cache/
**/proptest-regressions/**
# zaino-bench's run records: working notes, not published figures.
bench-results/
# Nix build output
/result
# Local tooling state
.claude/
.helix/
.local/
